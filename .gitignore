# ──────────────────────────────────────────────
# DripRig – .gitignore
# ──────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# ── Backend – runtime artifacts ───────────────
backend/uploads/
backend/results/
backend/__pycache__/
backend/**/__pycache__/

# ── Node / Frontend ───────────────────────────
node_modules/
frontend/node_modules/

# Vite build output
dist/
frontend/dist/
# Vite production build served by FastAPI — generated by CI, not committed
backend/static/

# Dependency lockfiles (keep package-lock.json; ignore yarn/pnpm if not used)
# Uncomment if you prefer not to track lockfile:
# package-lock.json

# ── Logs ─────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS & Editor ───────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# VSCode
.vscode/
!.vscode/extensions.json

# JetBrains IDEs
.idea/

# ── Misc ──────────────────────────────────────
*.tmp
*.bak
*.swp
*.swo
