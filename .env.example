# ──────────────────────────────────────────────────────────────────────────────
# DripRig — Environment Variable Reference
# Copy to .env for local development (never commit .env)
# For Azure: set these in Azure Portal → App Service → Configuration → App Settings
# ──────────────────────────────────────────────────────────────────────────────

# ── AI Model Credentials ─────────────────────────────────────────────────────
HUGGING_FACE_HUB_TOKEN=hf_your_token_here
REPLICATE_API_TOKEN=r8_your_token_here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Azure automatically injects WEBSITE_HOSTNAME, which is also added dynamically.
ALLOWED_ORIGINS=https://driprig.azurewebsites.net,https://your-custom-domain.com

# ── Storage Paths (Azure) ────────────────────────────────────────────────────
# Override where uploads/results are stored on disk.
# On Azure, /home/data is persistent across restarts.
# Omit locally — defaults to backend/uploads and backend/results.
# AZURE_DATA_DIR=/home/data
