# ──────────────────────────────────────────────────────────────────────────────
# DripRig — Environment Variable Reference
# Copy to .env for local development (never commit .env)
# For Render/Azure: set these in the platform's environment settings
# ──────────────────────────────────────────────────────────────────────────────

# ── AI Model Credentials ─────────────────────────────────────────────────────
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=https://your-domain.com

# ── Storage Paths (Azure) ────────────────────────────────────────────────────
# On Azure, /home/data is persistent across restarts.
# AZURE_DATA_DIR=/home/data

# ── Firebase Backend Config (used by image_service.py) ───────────────────────
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Frontend Firebase Config (Vite — prefix with VITE_) ──────────────────────
# These go in frontend/.env (not this file)
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
# VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
